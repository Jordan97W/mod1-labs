package grades;

public class Program {

	public static void main(String[] args) {

		String[] names = {"John", "Bill", "Bob", "Tim", "Jim"};
		int[] grade = new int[names.length];
		grade[0] = 50;
		grade[1] = 70;
		grade[2] = 3;
		grade[3] = 80;
		grade[4] = 5;
		
		
		for(int i = 0; i < names.length; i++) {
			
			getGrades(grade[i]);
			System.out.println(names[i] + ":  Grade: " + grade[i]);
		}
		

	}
	
	 public static String getGrades(int mark) {
		
		String grade = "";
		if (mark <= 50 && mark >= 1) {

			grade = "Fail";

		} else if (mark >= 50 && mark <= 60) {

			grade = "Pass";

		} else if (mark >= 61 && mark <= 70) {

			grade = "Merit";
		} else if (mark >= 71 && mark <= 100) {

			grade = "Distinction";

		} else {

			grade = "Error: mark must be between 1 and 100";
		}
		
		return grade;
	}

}
