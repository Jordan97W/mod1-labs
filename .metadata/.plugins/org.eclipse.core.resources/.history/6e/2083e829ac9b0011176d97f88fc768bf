package ballgame;

import java.awt.Color;

public class Shape {

    // Set variables for shape dimensions
    int x, y, w, h;

    // Direction of movement
    int dirX, dirY;

    // World border size
    public static int worldW = 600;
    public static int worldH = 400;

    // Shape type and colour
    private ShapeType shapeType;
    private Color colour;

    // Main constructor
    public Shape(int x, int y, int w, int h, int dirX, int dirY,
                 ShapeType shapeType, Color colour) {

        this.x = x;
        this.y = y;
        this.w = w;
        this.h = h;
        this.dirX = dirX;
        this.dirY = dirY;
        this.shapeType = shapeType;
        this.colour = colour;
    }

    // Constructor chaining
    // Default shape is a black oval with direction 1, 1
    public Shape(int x, int y, int w, int h, int dirX, int dirY) {
        this(x, y, w, h, dirX, dirY, ShapeType.Oval, Color.BLACK);
    }

    // Constructor for a default black oval with direction 1, 1
    public Shape(int x, int y, int w, int h) {
        this(x, y, w, h, 1, 1, ShapeType.Oval, Color.BLACK);
    }

    // Getter for shape type
    public ShapeType getShapeType() {
        return shapeType;
    }

    // Getter for colour
    public Color getColour() {
        return colour;
    }

    public void move() {

        // Move the shape
        x += dirX;
        y += dirY;

        // Left wall
        if (x < 0) {
            x = 0;
            dirX = -dirX;
        }

        // Top wall
        if (y < 0) {
            y = 0;
            dirY = -dirY;
        }

        // Right wall
        if (x > Shape.worldW - w) {
            x = Shape.worldW - w;
            dirX = -dirX;
        }

        // Bottom wall
        if (y > Shape.worldH - h) {
            y = Shape.worldH - h;
            dirY = -dirY;
        }
    }

    public static void setWorld(int w, int h) {
        worldW = w;
        worldH = h;
    }
}