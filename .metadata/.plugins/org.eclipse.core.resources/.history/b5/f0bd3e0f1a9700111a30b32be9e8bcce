package labs2;

public class Program {

	public static void main(String[] args) {
	
		int mark = 51;
		String grade = "";
		if (mark <= 50 && mark >= 1) {
			
			grade = "Fail";
			
		}else if(mark >= 50 && mark <= 60){
			
			grade = "Pass";
			
		}else if(mark >= 61 && mark <= 70)
		{
			
			grade = "Merit";
		}else if(mark >= 71 && mark <= 100) {
			
			grade = "Distinction";
			
		}else {
			
			System.out.println("Error: mark must be between 1 and 100");
		}
		
		System.out.println(grade);

	}

}
