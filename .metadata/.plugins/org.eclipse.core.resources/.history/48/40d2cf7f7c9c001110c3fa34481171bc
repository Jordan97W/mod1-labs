package lab8;

import java.util.ArrayList;
import java.util.Random;

public class Program {

	public static void main(String[] args) {
		// SET ARRAYLIST OF VECHICLES
		ArrayList<Vehicle> vehicles = new ArrayList<>();
		// ADD VEHICLES TO ARRAY
		try {
		    for (int i = 1; i <= 15; i++) {
		        vehicles.add(new Vehicle(0, i));
		    }
		} catch (NoRegistrationPlatesException e) {
		    System.out.println("Unable to create vehicle: " + e.getMessage());
		}
		System.out.println("Vehicles created:");
		// GET DETAILS FOR ALL VEHICLES IN ARRAY
		for (Vehicle vehicle : vehicles) {
			System.out.println(vehicle.getDetails());
		}
		
		System.out.println("Vehicle count: " + Vehicle.getCount());
		Random rand = new Random();
		boolean raceFinished = false;
		while (!raceFinished) {
			
			System.out.println("\n--- Race ---");

			for (Vehicle vehicle : vehicles) {

				int n = rand.nextInt(10) + 1;

				vehicle.accelerate(n);

				System.out.println(vehicle.getDetails());

				if (vehicle.getDistanceTravelled() >= 1000) {
					System.out.println("--------------\nWINNER!\n--------------");
					System.out.println(vehicle.getWinnerDetails());
					raceFinished = true;
					break;
				}
			}
		}
	}
}