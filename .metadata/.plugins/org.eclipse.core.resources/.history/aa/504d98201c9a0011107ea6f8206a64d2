package lab6;

public class Lab6 {

	public static void main(String[] args) {
		
		account();
	}

		
	    public static void account() {
	        double initialMoney = 100.00;
	        double currentMoney = initialMoney;
	        double interestRate = 0.05;
	        int years = 0;

	        while (currentMoney < 200.00) {
	            currentMoney = currentMoney + (currentMoney * interestRate);
	            years++;
	        }

	        System.out.println("It takes " + years + " years to reach £200.");
	        System.out.println("Final amount: £" + currentMoney);		
				
	    }

}
