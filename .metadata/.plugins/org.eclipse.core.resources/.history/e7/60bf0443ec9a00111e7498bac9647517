package qa;

public class Ball {

    int x, y, w, h;
    int dirX, dirY;

    public Ball(int x, int y, int w, int h, int dirX, int dirY) {
        this.x = x;
        this.y = y;
        this.w = w;
        this.h = h;
        this.dirX = dirX;
        this.dirY = dirY;
    }

    public void move() {
    	
    	if(x < 0) {
    	
        x += dirX;
        y += dirY;
        
    	}
    }
}