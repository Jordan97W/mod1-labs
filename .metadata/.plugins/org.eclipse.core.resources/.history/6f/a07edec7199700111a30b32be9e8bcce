public class Program {

	public static void main(String[] args) {
	
		int mark = 60;
		String grade = "blank";
		if (mark < 50) {
			
			grade = "Fail";
			
		}else if(mark >= 50 && mark <= 60){
			
			grade = "Pass";
			
		}else if(mark >= 61 && mark <= 70)
		{
			
			grade = "Merit";
		}else if(mark >= 71 && mark <= 100) {
			
			grade = "Distinction";
			
		}		
		
		System.out.println(grade);

	}

}
