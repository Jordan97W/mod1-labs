package lab6;

public class Lab6 {

	public static void main(String[] args) {

		account();
	}

	public static void account() {
		double initialMoney = 100.00;
		double currentMoney = initialMoney;
		double interestRate = 0.05;
		double targetMoney = 200.00;
		int years = 0;

		while (true) {

			years++;
			currentMoney += currentMoney * interestRate;

			if (currentMoney >= targetMoney) {

				break;
			}

		}

		System.out.println("It takes " + years + " years to reach £" + (int)targetMoney + ".");
		System.out.println("Final amount: £" + currentMoney);
	}
}
