package qa;

public class Ball {

	int x, y, w, h;
	int dirX, dirY;

	public Ball(int x, int y, int w, int h, int dirX, int dirY) {
		this.x = x;
		this.y = y;
		this.w = w;
		this.h = h;
		this.dirX = dirX;
		this.dirY = dirY;
	}

	public Ball(int dirX, int dirY) {

	}

	public void move() {

		// Move the ball
		x += dirX;
		y += dirY;

		// Left wall
		if (x < 0) {
			x = 0;
			dirX = -dirX;
		}

		// Top wall
		if (y < 0) {
			y = 0;
			dirY = -dirY;
		}

		// Right wall
		if (x > 300 - w) {
			x = 300 - w;
			dirX = -dirX;
		}

		// Bottom wall
		if (y > 300 - h) {
			y = 300 - h;
			dirY = -dirY;
		}
	}
}