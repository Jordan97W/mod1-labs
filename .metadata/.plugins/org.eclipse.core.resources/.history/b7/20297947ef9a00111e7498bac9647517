package qa;

public class Ball {

	int x, y, w, h;
	int dirX, dirY;

	public Ball(int dirX, int dirY) {

	    this.dirX = dirX;
	    this.dirY = dirY;
	}

	public Ball(int x, int y, int w, int h) {
	    this(1,1);
	}

	public void move() {

		// Move the ball
		x += dirX;
		y += dirY;

		// Left wall
		if (x < 0) {
			x = 0;
			dirX = -dirX;
		}

		// Top wall
		if (y < 0) {
			y = 0;
			dirY = -dirY;
		}

		// Right wall
		if (x > 600 - w) {
			x = 600 - w;
			dirX = -dirX;
		}

		// Bottom wall
		if (y > 450 - h) {
			y = 450 - h;
			dirY = -dirY;
		}
	}
}